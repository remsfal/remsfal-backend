<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="remsfal-platform-000-optimize-liquibase-tables" author="alexander.stanik@htw-berlin.de">
        <comment>Initialize Liquibase metadata table</comment>

        <createIndex tableName="DATABASECHANGELOG" indexName="idx_date_order_executed">
            <column name="DATEEXECUTED"/>
            <column name="ORDEREXECUTED"/>
        </createIndex>
        <addPrimaryKey tableName="DATABASECHANGELOG" constraintName="pk_databasechangelog"
                columnNames="ID,AUTHOR,FILENAME"/>
    </changeSet>

</databaseChangeLog>
