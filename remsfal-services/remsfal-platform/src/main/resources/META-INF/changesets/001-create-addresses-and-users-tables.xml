<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="remsfal-platform-001-addresses-and-users" author="alexander.stanik@htw-berlin.de">
        <comment>Create user management schema with addresses and users tables</comment>

        <createTable tableName="addresses">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="street" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="city" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="zip" type="varchar(10)">
                <constraints nullable="false" />
            </column>
            <column name="province" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="country" type="varchar(2)">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false" />
            </column>
            <column name="modified_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createTable tableName="users">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="token_id" type="varchar(255)" />
            <column name="email" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="authenticated_at" type="timestamp">
                <constraints nullable="true" />
            </column>
            <column name="first_name" type="varchar(255)" />
            <column name="last_name" type="varchar(255)" />
            <column name="place_of_birth" type="varchar(255)" />
            <column name="date_of_birth" type="date" />
            <column name="locale" type="varchar(2)" />
            <column name="address_id" type="uuid" />
            <column name="mobile_phone_number" type="varchar(15)" remarks="According to E.164" />
            <column name="business_phone_number" type="varchar(15)" remarks="According to E.164"/>
            <column name="private_phone_number" type="varchar(15)" remarks="According to E.164"/>
            <column name="created_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false" />
            </column>
            <column name="modified_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false" />
            </column>
        </createTable>

        <addUniqueConstraint tableName="users" columnNames="email" constraintName="unique_user_email" />
        <addUniqueConstraint tableName="users" columnNames="token_id" constraintName="unique_user_token_id" />

        <createIndex indexName="idx_user_email_lookup" tableName="users">
            <column name="email" type="varchar(255)" />
        </createIndex>
        <createIndex indexName="idx_user_token_id_lookup" tableName="users">
            <column name="token_id" type="varchar(255)" />
        </createIndex>

        <addForeignKeyConstraint constraintName="fk_address_id"
                                 baseTableName="users" baseColumnNames="address_id"
                                 referencedTableName="addresses" referencedColumnNames="id"
                                 onDelete="SET NULL" onUpdate="RESTRICT" />

        <createIndex indexName="idx_users_address_fk" tableName="users">
            <column name="address_id" type="uuid" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
