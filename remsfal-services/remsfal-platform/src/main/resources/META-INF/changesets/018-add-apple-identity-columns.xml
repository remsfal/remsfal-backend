<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="remsfal-platform-018-apple-identity-columns" author="alexander.stanik@htw-berlin.de">
        <comment>Store the Sign in with Apple refresh token (for revocation) and the email relay status</comment>

        <addColumn tableName="user_identities">
            <column name="refresh_token" type="varchar(1024)"/>
            <column name="token_client_id" type="varchar(255)"/>
            <column name="email_disabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
