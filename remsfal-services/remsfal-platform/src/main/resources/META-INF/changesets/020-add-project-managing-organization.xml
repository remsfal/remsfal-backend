<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="remsfal-platform-020-project-managing-organization" author="alexander.stanik@htw-berlin.de">
        <comment>Designate at most one managing organization per project (null for projects managed by individuals)</comment>

        <addColumn tableName="projects">
            <column name="managing_organization_id" type="uuid">
                <constraints nullable="true" />
            </column>
        </addColumn>

        <addForeignKeyConstraint constraintName="fk_projects_managing_organization_id"
                                 baseTableName="projects" baseColumnNames="managing_organization_id"
                                 referencedTableName="organizations" referencedColumnNames="id"
                                 onDelete="SET NULL" onUpdate="RESTRICT" />

        <createIndex indexName="idx_projects_managing_organization_fk" tableName="projects">
            <column name="managing_organization_id" type="uuid" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
