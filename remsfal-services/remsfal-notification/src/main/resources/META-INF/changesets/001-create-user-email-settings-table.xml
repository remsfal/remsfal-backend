<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="remsfal-notification-001-user-email-settings" author="alexander.stanik@htw-berlin.de">
        <comment>Create email settings table with one row per user and one flag per configurable email</comment>

        <createTable tableName="user_email_settings">
            <column name="user_id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_email_settings" />
            </column>
            <column name="issue_created" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="issue_updated" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="issue_assigned" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="issue_message_created" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false" />
            </column>
            <column name="modified_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
